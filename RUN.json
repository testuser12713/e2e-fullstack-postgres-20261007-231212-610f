{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "."]],
      "start": ["${python}", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/api/health", "expect_status": [200] },
      "test": [["${python}", "-m", "pytest", "-q"]],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "OFFICE_TZ": { "dev": "Europe/Berlin" }
      },
      "depends_on": ["db"]
    },
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "ci", "--no-audit", "--no-fund"]],
      "start": ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "${PORT}"],
      "port": 5173,
      "port_env": "PORT",
      "health": { "path": "/", "expect_status": [200] },
      "depends_on": ["api"],
      "env": {
        "API_PROXY_TARGET": { "dev": "${service:api.origin}" }
      },
      "build": [["npm", "run", "build"]],
      "test": [["npm", "test", "--", "--run"]]
    }
  ]
}
